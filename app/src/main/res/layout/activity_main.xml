<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aqua_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <include
                layout="@layout/view_aqua_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_title"
                android:textColor="@color/aqua_text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/aqua_muted_light"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_water_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_consumption"
                    android:textColor="@color/aqua_muted_light"
                    android:textSize="15sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConsumed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/initial_water_consumption"
                    android:textColor="@color/aqua_primary"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressWater"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="18dp"
                    android:max="2000"
                    android:progress="0"
                    android:progressTint="@color/aqua_primary"
                    android:progressBackgroundTint="@color/aqua_divider" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/initial_water_progress"
                    android:textColor="@color/aqua_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/aqua_divider" />

                <TextView
                    android:id="@+id/tvDailyGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:text="@string/initial_daily_goal"
                    android:textColor="@color/aqua_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/add_water_title"
                android:textColor="@color/aqua_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/add_water_subtitle"
                android:textColor="@color/aqua_muted_light"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btn200"
                    style="@style/AquaButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/water_200"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn300"
                    style="@style/AquaButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/water_300"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn500"
                    style="@style/AquaButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/water_500"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/aqua_divider"
                android:minHeight="0dp"
                android:text="@string/undo_water"
                android:textColor="@color/aqua_text"
                android:textSize="15sp"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
