<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_water_card"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="18dp">

    <View
        android:layout_width="4dp"
        android:layout_height="42dp"
        android:layout_marginEnd="14dp"
        android:background="@color/aqua_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoje, 28 de Out"
            android:textColor="@color/aqua_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Consumo de água"
            android:textColor="@color/aqua_muted_light"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvItemAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="2500 ml"
        android:textColor="@color/aqua_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
